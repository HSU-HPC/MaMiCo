<?xml version="1.0"?>

<mamico>
  <coupling-cell-configuration
    cell-size="2.5 ; 2.5; 2.5"
    linked-cells-per-coupling-cell=" 1 ; 1 ; 1"
    write-every-microscopic-timestep="0"
    microscopic-filename="CouplingCell_micro"
    write-every-macroscopic-timestep="1"
    macroscopic-filename="CouplingCell_macro"
  />
  <particle-insertion type="none" />
  <momentum-insertion type="none"  />
  <!-- the 2*dim side flags are read unconditionally, also for type="none" -->
  <boundary-force type="none"
                  west="no" east="no" south="no" north="no" bottom="no" top="no" />
  <transfer-strategy type="direct-transfer" />
  <parallel-topology type="xyz" />
  <!-- mandatory since ThermostatConfiguration was introduced; "nowhere" keeps this dummy
       test setup thermostat-free, as it was before the tag existed -->
  <thermostat type="nowhere" />
</mamico>

