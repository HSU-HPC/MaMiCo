/*--------------------------------*- C++ -*----------------------------------*
  UMD (generated by mamico-cfg)
  Carrier for the MD velocity received through preCICE on the hole faces. It
  never enters the equations: the hole condition on U reads it, see 0/U.
----------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      UMD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    movingWall  { type zeroGradient; }
    fixedWall   { type zeroGradient; }
    xMin        { type zeroGradient; }
    xMax        { type zeroGradient; }
    yMin        { type zeroGradient; }
    yMax        { type zeroGradient; }

    lefti       { type fixedValue; value uniform (0 0 0); }
    righti      { type fixedValue; value uniform (0 0 0); }
    fronti      { type fixedValue; value uniform (0 0 0); }
    backi       { type fixedValue; value uniform (0 0 0); }
    buttomi     { type fixedValue; value uniform (0 0 0); }
    topi        { type fixedValue; value uniform (0 0 0); }
}

// ************************************************************************* //
