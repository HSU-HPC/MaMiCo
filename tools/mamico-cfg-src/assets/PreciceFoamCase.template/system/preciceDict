/*--------------------------------*- C++ -*----------------------------------*
  preciceDict (generated by mamico-cfg)
----------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      preciceDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

preciceConfig "{precice-config}";

participant {foam-participant};

// FF claims data names by case-insensitive prefix, so Velocity* reaches its U coupler.
modules (FF);

// Schwarz-style split, mirroring the direct IcoFoam coupling in MaMiCo:
//   MD  -> CFD  as Dirichlet values on the hole surface (faceCenters)
//   CFD -> MD   from real CFD cells just outside the hole (volumeCenters)
// The two directions never share a location, so nothing is read back from
// what was just written.
interfaces
{
  MD2Macro
  {
    mesh              {foam-mesh-inner};
    patches           ({inner-patches});
    locations         faceCenters;

    readData
    (
      {md2macro-data}
    );
  };

  Macro2MD
  {
    mesh              {foam-mesh-outer};
    patches           ();
    locations         volumeCenters;
    cellSets          ({cell-set-shell});

    writeData
    (
      {macro2md-data}
    );
  };
};

FF
{
  solverType  incompressible;
  nameU       U;
  nameP       p;
}

// ************************************************************************* //
