// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The MD region is a hole containing no cells, so a box covering the hole plus
// a few layers selects exactly the shell of cells around it. Those carry real
// CFD solution values out to the MaMiCo overlap layers.
//
// When the hole is pulled inside the md2macro region (_precice_hole_inset > 0)
// the first box also picks up the CFD cells that overlap md2macro. The delete
// action removes them again, so mdShell stays exactly the macro2MD layers that
// CouettePreciceInterface::getOuterRegion() defines. With inset 0 the deleted
// box holds no cells and the action does nothing.
actions
(
    {
        name    {cell-set-shell};
        type    cellSet;
        action  new;
        source  boxToCell;
        box     ({shell-min}) ({shell-max});
    }
    {
        name    {cell-set-shell};
        type    cellSet;
        action  delete;
        source  boxToCell;
        box     ({shell-cut-min}) ({shell-cut-max});
    }
);

