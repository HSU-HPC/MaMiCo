<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration>
  <log>
    <sink filter="%Severity% > debug" enabled="true" />
  </log>

  <data:vector name="{macro2md-data}" />
  <data:vector name="{md2macro-data}" />

  <!-- MaMiCo provides one mesh per coupling direction, at coupling cell midpoints -->
  <mesh name="{macro2md-mesh}" dimensions="3">
    <use-data name="{macro2md-data}" />
  </mesh>
  <mesh name="{md2macro-mesh}" dimensions="3">
    <use-data name="{md2macro-data}" />
  </mesh>

  <!-- OpenFOAM provides one mesh per direction too, on disjoint cell sets -->
  <mesh name="{foam-mesh-outer}" dimensions="3">
    <use-data name="{macro2md-data}" />
  </mesh>
  <mesh name="{foam-mesh-inner}" dimensions="3">
    <use-data name="{md2macro-data}" />
  </mesh>

  <participant name="{mamico-participant}">
    <provide-mesh name="{macro2md-mesh}" />
    <provide-mesh name="{md2macro-mesh}" />
    <read-data name="{macro2md-data}" mesh="{macro2md-mesh}" />
    <write-data name="{md2macro-data}" mesh="{md2macro-mesh}" />
  </participant>

  <participant name="{foam-participant}">
    <provide-mesh name="{foam-mesh-outer}" />
    <provide-mesh name="{foam-mesh-inner}" />
    <receive-mesh name="{macro2md-mesh}" from="{mamico-participant}" />
    <receive-mesh name="{md2macro-mesh}" from="{mamico-participant}" />
    <write-data name="{macro2md-data}" mesh="{foam-mesh-outer}" />
    <read-data name="{md2macro-data}" mesh="{foam-mesh-inner}" />
    <mapping:nearest-neighbor direction="write" from="{foam-mesh-outer}" to="{macro2md-mesh}" constraint="consistent" />
    <!-- MD -> CFD read mapping onto the hole faces, chosen by the hole_operator option in solver_cfd.py -->
    <mapping:nearest-neighbor direction="read" from="{md2macro-mesh}" to="{foam-mesh-inner}" constraint="consistent" />
  </participant>

  <m2n:sockets acceptor="{mamico-participant}" connector="{foam-participant}" />

  <coupling-scheme:serial-explicit>
    <participants first="{foam-participant}" second="{mamico-participant}" />
    <max-time-windows value="{max-time-windows}" />
    <time-window-size value="{time-window-size}" />
    <exchange data="{macro2md-data}" mesh="{macro2md-mesh}" from="{foam-participant}" to="{mamico-participant}" />
    <exchange data="{md2macro-data}" mesh="{md2macro-mesh}" from="{mamico-participant}" to="{foam-participant}" />
  </coupling-scheme:serial-explicit>
</precice-configuration>
